# Generate unique local credentials with scripts/init-env.py; never commit .env or runtime/.
MYSQL_ROOT_PASSWORD=
DATABASE_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
WEB_PORT=8131
BIND_ADDRESS=127.0.0.1
RTC_BIND_ADDRESS=127.0.0.1
RTC_TCP_PORT=7921
RTC_UDP_PORT=7922
# Set an address reachable by clients; localhost is for same-machine tests only.
RTC_NODE_IP=127.0.0.1
TURN_UDP_PORT=7923
LIVEKIT_CONFIG_PATH=./runtime/livekit.yaml
COOKIE_SECURE=false

# Keep the relay range small; expose only required UDP ports on your own server.
TURN_RELAY_START=7930
TURN_RELAY_END=7940
